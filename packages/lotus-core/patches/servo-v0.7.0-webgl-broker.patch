+use rustc_hash::FxHashMap;
+use servo_base::Epoch;
+use servo_base::generic_channel::GenericReceiver;
+use servo_canvas_traits::webgl::{
+    webgl_channel, WebGLChan, WebGLContextId, WebGLCreateContextResult, WebGLMsg, WebGLMsgSender,
+};
+use webrender_api::{
+    ExternalImageData, ExternalImageId, ExternalImageType, ImageDescriptor, ImageDescriptorFlags,
+    ImageFormat, ImageKey,
+};
+use webrender_api::units::DeviceIntSize;
+
+use crate::broker_canvas::{
+    forget_plane, insert_plane, map_ro_logged, sync_presented_from_plane, CanvasPlaneMap,
+};
+use crate::broker_frame::{
+    read_frame_with_optional_fd, write_frame, GpuFrameHeader, KIND_CANVAS_PRESENT, KIND_COMMAND,
+    KIND_PING, KIND_PONG, KIND_REPLY,
+};
+use crate::broker_msg::{WireCreateContextOk, WireReply, WireWebGLMsg};
+use crate::broker_wire::{strip_webgl_command, PendingReply};
+use crate::webgl_presented_frames::WebGLPresentedBufferMap;
+
+/// Local WR bookkeeping for brokered contexts (host owns GL; jail owns display list / WR).
+struct LocalImageState {
+    image_key: Option<ImageKey>,
+    size: Size2D<i32>,
+    alpha: bool,
+    pending_epoch: Option<Epoch>,
+}
+
+fn external_buffer_data(context_id: WebGLContextId) -> paint_api::SerializableImageData {
+    paint_api::SerializableImageData::External(ExternalImageData {
+        id: ExternalImageId(context_id.0),
+        channel_index: 0,
+        image_type: ExternalImageType::Buffer,
+        normalized_uvs: false,
+    })
+}
+
+fn image_descriptor(size: Size2D<i32>, alpha: bool) -> ImageDescriptor {
+    let mut flags = ImageDescriptorFlags::empty();
+    flags.set(ImageDescriptorFlags::IS_OPAQUE, !alpha);
+    ImageDescriptor {
+        size: DeviceIntSize::new(size.width, size.height),
+        stride: None,
+        format: ImageFormat::BGRA8,
+        offset: 0,
+        flags,
+    }
+}
+
+struct PendingSlot {
+    reply: Option<Vec<u8>>,
+    fd: Option<RawFd>,
+}
+
+struct PendingState {
+    map: HashMap<u64, PendingReply>,
+    slots: HashMap<u64, PendingSlot>,
+    waiting: HashMap<u64, Arc<(Mutex<bool>, Condvar)>>,
+}
+
+fn parse_gpu_fd() -> Option<RawFd> {
+    std::env::var("LOTUS_GPU_FD")
+        .ok()
+        .and_then(|v| v.parse().ok())
+}
+
+pub fn should_use_gpu_broker() -> bool {
+    parse_gpu_fd().is_some()
+}
+
+fn context_id_for_blame(wire: &WireWebGLMsg) -> u64 {
+    match wire {
+        WireWebGLMsg::WebGLCommand(id, ..) => id.0,
+        WireWebGLMsg::RemoveContext(id) => id.0,
+        WireWebGLMsg::ResizeContext { context_id, .. } => context_id.0,
+        WireWebGLMsg::SetImageKey(id, _) => id.0,
+        WireWebGLMsg::FinishedRenderingToContext(id) => id.0,
+        WireWebGLMsg::SwapBuffers(ids, ..) => ids.first().map(|i| i.0).unwrap_or(0),
+        _ => 0,
+    }
+}
+
+fn send_command(fd: RawFd, wire: &WireWebGLMsg) -> Result<(), ()> {
+    let body = rmp_serde::to_vec(wire).map_err(|e| {
+        warn!("[webgl-bridge] encode failed: {e}");
+    })?;
+    let hdr = GpuFrameHeader {
+        body_len: body.len() as u32,
+        corr: 0,
+        context_id: context_id_for_blame(wire),
+        kind: KIND_COMMAND,
+    };
+    write_frame(fd, hdr, &body).map_err(|e| {
+        warn!("[webgl-bridge] write command failed: {e}");
+    })
+}
+
+/// Bridge + dedicated fd-reader so `KIND_CANVAS_PRESENT` can arrive while waiting on replies.
+///
+/// `paint_api` / `external_image_id_manager` are the *jail* paint endpoints: GL runs on the host,
+/// but ImageKey registration and Buffer external-image updates must hit local WebRender.
+pub fn run_bridge(
+    receiver: GenericReceiver<WebGLMsg>,
+    webgl_chan: WebGLChan,
+    presented_buffer_map: WebGLPresentedBufferMap,
+    paint_api: CrossProcessPaintApi,
+    mut external_image_id_manager: WebRenderExternalImageIdManager,
+) -> JoinHandle<()> {
+    std::thread::Builder::new()
+        .name("lotus-webgl-bridge".into())
+        .spawn(move || {
+            let Some(fd) = parse_gpu_fd() else {
+                warn!("[webgl-bridge] LOTUS_GPU_FD missing; bridge exiting");
+                return;
+            };
+
+            let pending = Arc::new(Mutex::new(PendingState {
+                map: HashMap::new(),
+                slots: HashMap::new(),
+                waiting: HashMap::new(),
+            }));
+            let planes: CanvasPlaneMap =
+                Arc::new(RwLock::new(FxHashMap::default()));
+            let stop = Arc::new(AtomicBool::new(false));
+            let local_images: Arc<Mutex<HashMap<WebGLContextId, LocalImageState>>> =
+                Arc::new(Mutex::new(HashMap::new()));
+
+            // Handshake
+            let ping = GpuFrameHeader {
+                body_len: 0,
+                corr: 1,
+                context_id: 0,
+                kind: KIND_PING,
+            };
+            if write_frame(fd, ping, &[]).is_err() {
+                warn!("[webgl-bridge] initial ping failed");
+                return;
+            }
+
+            let pending_r = Arc::clone(&pending);
+            let planes_r = Arc::clone(&planes);
+            let presented_r = presented_buffer_map.clone();
+            let stop_r = Arc::clone(&stop);
+            let local_images_r = Arc::clone(&local_images);
+            let paint_api_r = paint_api.clone();
+            let reader = std::thread::Builder::new()
+                .name("lotus-gpu-fd-reader".into())
+                .spawn(move || {
+                    fd_reader_loop(
+                        fd,
+                        pending_r,
+                        planes_r,
+                        presented_r,
+                        stop_r,
+                        local_images_r,
+                        paint_api_r,
+                    );
+                })
+                .expect("spawn gpu fd reader");
+
+            let mut next_corr: u64 = 1;
+            debug!("[webgl-bridge] started on fd {fd}");
+
+            while let Ok(msg) = receiver.recv() {
+                if stop.load(Ordering::SeqCst) {
+                    break;
+                }
+                if let WebGLMsg::CreateContext(painter_id, version, size, attrs, sender) = msg {
+                    let corr = {
+                        next_corr = next_corr.wrapping_add(1);
+                        next_corr
+                    };
+                    let chan = webgl_chan.clone();
+                    let wait = register_waiter(&pending, corr);
+                    let has_alpha = attrs.alpha;
+
+                    let wire = WireWebGLMsg::CreateContext {
+                        painter_id,
+                        version,
+                        size,
+                        attrs,
+                        corr,
+                    };
+                    if send_command(fd, &wire).is_err() {
+                        let _ = sender.send(Err("GPU broker send failed".into()));
+                        break;
+                    }
+                    match wait_reply(&pending, corr, &wait) {
+                        Some((body, pass_fd)) => {
+                            match rmp_serde::from_slice::<WireReply>(&body) {
+                                Ok(WireReply::CreateContext(Ok(ok))) => {
+                                    if let Some(cfd) = pass_fd {
+                                        if let Some(reader) = map_ro_logged(cfd) {
+                                            insert_plane(&planes, ok.context_id, reader);
+                                        }
+                                    }
+                                    // Host allocated ExternalImageId == context_id; register locally
+                                    // so jail WR's ExternalImageHandler can resolve locks.
+                                    external_image_id_manager.register_id(
+                                        ExternalImageId(ok.context_id.0),
+                                        WebRenderImageHandlerType::WebGl,
+                                    );
+                                    local_images.lock().unwrap().insert(
+                                        ok.context_id,
+                                        LocalImageState {
+                                            image_key: None,
+                                            size: Size2D::new(
+                                                size.width.max(1) as i32,
+                                                size.height.max(1) as i32,
+                                            ),
+                                            alpha: has_alpha,
+                                            pending_epoch: None,
+                                        },
+                                    );
+                                    let result = WebGLCreateContextResult {
+                                        sender: WebGLMsgSender::new(ok.context_id, chan),
+                                        limits: ok.limits,
+                                        glsl_version: ok.glsl_version,
+                                        api_type: ok.api_type,
+                                    };
+                                    let _ = sender.send(Ok(result));
+                                },
+                                Ok(WireReply::CreateContext(Err(e))) => {
+                                    if let Some(cfd) = pass_fd {
+                                        unsafe {
+                                            libc::close(cfd);
+                                        }
+                                    }
+                                    let _ = sender.send(Err(e));
+                                },
+                                _ => {
+                                    if let Some(cfd) = pass_fd {
+                                        unsafe {
+                                            libc::close(cfd);
+                                        }
+                                    }
+                                    let _ = sender.send(Err("GPU broker bad create reply".into()));
+                                },
+                            }
+                        },
+                        None => {
+                            let _ = sender.send(Err("GPU broker timeout".into()));
+                        },
+                    }
+                    continue;
+                }
+
+                // SetImageKey must update *jail* WebRender — host paint_api is a dummy.
+                if let WebGLMsg::SetImageKey(ctx_id, image_key) = msg {
+                    let mut map = local_images.lock().unwrap();
+                    let Some(info) = map.get_mut(&ctx_id) else {
+                        paint_api.delete_image(image_key);
+                        continue;
+                    };
+                    if let Some(old) = info.image_key.replace(image_key) {
+                        paint_api.delete_image(old);
+                        continue;
+                    }
+                    let initial_size = presented_buffer_map
+                        .read()
+                        .get(&ctx_id)
+                        .map(|f| f.size)
+                        .unwrap_or(info.size);
+                    paint_api.add_image(
+                        image_key,
+                        image_descriptor(initial_size, info.alpha),
+                        external_buffer_data(ctx_id),
+                        false,
+                    );
+                    continue;
+                }
+
+                if let WebGLMsg::ResizeContext(context_id, size, sender) = msg {
+                    let corr = {
+                        next_corr = next_corr.wrapping_add(1);
+                        next_corr
+                    };
+                    let wait = register_waiter(&pending, corr);
+                    let wire = WireWebGLMsg::ResizeContext {
+                        context_id,
+                        size,
+                        corr,
+                    };
+                    if send_command(fd, &wire).is_err() {
+                        let _ = sender.send(Err("GPU broker send failed".into()));
+                        break;
+                    }
+                    match wait_reply(&pending, corr, &wait) {
+                        Some((body, pass_fd)) => {
+                            match rmp_serde::from_slice::<WireReply>(&body) {
+                                Ok(WireReply::ResizeContext(Ok(()))) => {
+                                    if let Some(cfd) = pass_fd {
+                                        if let Some(reader) = map_ro_logged(cfd) {
+                                            insert_plane(&planes, context_id, reader);
+                                        }
+                                    }
+                                    if let Some(info) =
+                                        local_images.lock().unwrap().get_mut(&context_id)
+                                    {
+                                        info.size = Size2D::new(
+                                            size.width.max(1) as i32,
+                                            size.height.max(1) as i32,
+                                        );
+                                        // Defer paint_api.update_image until sync_presented_from_plane
+                                        // copies a frame at actual size on KIND_CANVAS_PRESENT.
+                                    }
+                                    let _ = sender.send(Ok(()));
+                                },
+                                Ok(WireReply::ResizeContext(Err(e))) => {
+                                    if let Some(cfd) = pass_fd {
+                                        unsafe {
+                                            libc::close(cfd);
+                                        }
+                                    }
+                                    let _ = sender.send(Err(e));
+                                },
+                                _ => {
+                                    if let Some(cfd) = pass_fd {
+                                        unsafe {
+                                            libc::close(cfd);
+                                        }
+                                    }
+                                    let _ = sender.send(Err("GPU broker bad resize reply".into()));
+                                },
+                            }
+                        },
+                        None => {
+                            let _ = sender.send(Err("GPU broker timeout".into()));
+                        },
+                    }
+                    continue;
+                }
+
+                if let WebGLMsg::RemoveContext(id) = msg {
+                    forget_plane(&planes, id);
+                    presented_buffer_map.write().remove(&id);
+                    if let Some(info) = local_images.lock().unwrap().remove(&id) {
+                        if let Some(key) = info.image_key {
+                            paint_api.delete_image(key);
+                        }
+                    }
+                    external_image_id_manager.remove(&ExternalImageId(id.0));
+                    let wire = WireWebGLMsg::RemoveContext(id);
+                    if send_command(fd, &wire).is_err() {
+                        break;
+                    }
+                    continue;
+                }
+
+                if let WebGLMsg::SwapBuffers(ref ids, epoch, _) = msg {
+                    let mut map = local_images.lock().unwrap();
+                    for id in ids {
+                        if let Some(info) = map.get_mut(id) {
+                            info.pending_epoch = epoch;
+                        }
+                    }
+                }
+
+                let Some((wire, pend)) = strip_msg(msg, &mut next_corr) else {
+                    continue;
+                };
+                let wait_corr = pend.as_ref().map(|(c, _)| *c);
+                let wait = wait_corr.map(|c| register_waiter(&pending, c));
+                if let Some((corr, p)) = pend {
+                    pending.lock().unwrap().map.insert(corr, p);
+                }
+                if send_command(fd, &wire).is_err() {
+                    break;
+                }
+                if let (Some(corr), Some(w)) = (wait_corr, wait) {
+                    if let Some((body, pass_fd)) = wait_reply(&pending, corr, &w) {
+                        if let Some(cfd) = pass_fd {
+                            unsafe {
+                                libc::close(cfd);
+                            }
+                        }
+                        if let Some(p) = pending.lock().unwrap().map.remove(&corr) {
+                            p(Some(body));
+                        }
+                    } else if let Some(p) = pending.lock().unwrap().map.remove(&corr) {
+                        p(None);
+                    }
+                }
+                if matches!(wire, WireWebGLMsg::Exit) {
+                    break;
+                }
+            }
+
+            stop.store(true, Ordering::SeqCst);
+            let _ = reader.join();
+            let mut st = pending.lock().unwrap();
+            for (_, p) in st.map.drain() {
+                p(None);
+            }
+        })
+        .expect("spawn webgl bridge")
+}
+
+fn register_waiter(
+    pending: &Arc<Mutex<PendingState>>,
+    corr: u64,
+) -> Arc<(Mutex<bool>, Condvar)> {
+    let pair = Arc::new((Mutex::new(false), Condvar::new()));
+    pending.lock().unwrap().waiting.insert(corr, Arc::clone(&pair));
+    pair
+}
+
+fn wait_reply(
+    pending: &Arc<Mutex<PendingState>>,
+    corr: u64,
+    wait: &Arc<(Mutex<bool>, Condvar)>,
+) -> Option<(Vec<u8>, Option<RawFd>)> {
+    let (lock, cvar) = &**wait;
+    let mut ready = lock.lock().unwrap();
+    while !*ready {
+        ready = cvar.wait(ready).unwrap();
+    }
+    let mut st = pending.lock().unwrap();
+    st.waiting.remove(&corr);
+    st.slots.remove(&corr).map(|s| (s.reply.unwrap_or_default(), s.fd))
+}
+
+fn deliver_reply(
+    pending: &Arc<Mutex<PendingState>>,
+    corr: u64,
+    body: Vec<u8>,
+    pass_fd: Option<RawFd>,
+) {
+    let mut st = pending.lock().unwrap();
+    if let Some(pair) = st.waiting.get(&corr).cloned() {
+        st.slots.insert(
+            corr,
+            PendingSlot {
+                reply: Some(body),
+                fd: pass_fd,
+            },
+        );
+        let (lock, cvar) = &*pair;
+        let mut ready = lock.lock().unwrap();
+        *ready = true;
+        cvar.notify_one();
+    } else if let Some(p) = st.map.remove(&corr) {
+        // Fire-and-forget style pending (legacy); no waiter.
+        if let Some(cfd) = pass_fd {
+            unsafe {
+                libc::close(cfd);
+            }
+        }
+        p(Some(body));
+    } else if let Some(cfd) = pass_fd {
+        unsafe {
+            libc::close(cfd);
+        }
+    }
+}
+
+fn fd_reader_loop(
+    fd: RawFd,
+    pending: Arc<Mutex<PendingState>>,
+    planes: CanvasPlaneMap,
+    presented: WebGLPresentedBufferMap,
+    stop: Arc<AtomicBool>,
+    local_images: Arc<Mutex<HashMap<WebGLContextId, LocalImageState>>>,
+    paint_api: CrossProcessPaintApi,
+) {
+    while !stop.load(Ordering::SeqCst) {
+        let (hdr, body, pass_fd) = match read_frame_with_optional_fd(fd) {
+            Ok(v) => v,
+            Err(e) => {
+                if e != "E_EOF" {
+                    warn!("[webgl-bridge] fd reader ended ({e})");
+                }
+                stop.store(true, Ordering::SeqCst);
+                // Wake any waiters
+                let mut st = pending.lock().unwrap();
+                for (_, pair) in st.waiting.drain() {
+                    let (lock, cvar) = &*pair;
+                    let mut ready = lock.lock().unwrap();
+                    *ready = true;
+                    cvar.notify_one();
+                }
+                break;
+            },
+        };
+        match hdr.kind {
+            KIND_PONG => {
+                debug!("[webgl-bridge] pong corr={}", hdr.corr);
+            },
+            KIND_REPLY => {
+                deliver_reply(&pending, hdr.corr, body, pass_fd);
+            },
+            KIND_CANVAS_PRESENT => {
+                if let Some(cfd) = pass_fd {
+                    unsafe {
+                        libc::close(cfd);
+                    }
+                }
+                let ctx = WebGLContextId(hdr.context_id);
+                if let Some(actual_frame_size) = sync_presented_from_plane(&planes, &presented, ctx) {
+                    let mut map = local_images.lock().unwrap();
+                    if let Some(info) = map.get_mut(&ctx) {
+                        if let Some(key) = info.image_key {
+                            let wire_epoch = (hdr.corr > 0).then(|| Epoch((hdr.corr - 1) as u32));
+                            let epoch = wire_epoch.or_else(|| info.pending_epoch.take());
+                            if wire_epoch.is_some() && info.pending_epoch == wire_epoch {
+                                info.pending_epoch = None;
+                            }
+                            info.size = actual_frame_size;
+                            paint_api.update_image(
+                                key,
+                                image_descriptor(actual_frame_size, info.alpha),
+                                external_buffer_data(ctx),
+                                epoch,
+                            );
+                        }
+                    }
+                }
+            },
+            KIND_PING => {
+                let pong = GpuFrameHeader {
+                    body_len: 0,
+                    corr: hdr.corr,
+                    context_id: 0,
+                    kind: KIND_PONG,
+                };
+                let _ = write_frame(fd, pong, &[]);
+            },
+            other => {
+                if let Some(cfd) = pass_fd {
+                    unsafe {
+                        libc::close(cfd);
+                    }
+                }
+                warn!("[webgl-bridge] unexpected kind {other}");
+            },
+        }
+    }
+}
+
+fn strip_msg(
+    msg: WebGLMsg,
+    next_corr: &mut u64,
+) -> Option<(WireWebGLMsg, Option<(u64, PendingReply)>)> {
+    match msg {
+        WebGLMsg::CreateContext(..)
+        | WebGLMsg::ResizeContext(..)
+        | WebGLMsg::RemoveContext(_)
+        | WebGLMsg::SetImageKey(..) => {
+            unreachable!("handled before strip_msg");
+        },
+        WebGLMsg::WebGLCommand(id, cmd, bt) => {
+            let (wire_cmd, pending) = strip_webgl_command(cmd, next_corr);
+            Some((WireWebGLMsg::WebGLCommand(id, wire_cmd, bt), pending))
+        },
+        WebGLMsg::SwapBuffers(ids, epoch, t) => {
+            Some((WireWebGLMsg::SwapBuffers(ids, epoch, t), None))
+        },
+        WebGLMsg::FinishedRenderingToContext(id) => {
+            Some((WireWebGLMsg::FinishedRenderingToContext(id), None))
+        },
+        WebGLMsg::ClearPainterResources(painter_id, sender) => {
+            let corr = {
+                *next_corr = next_corr.wrapping_add(1);
+                *next_corr
+            };
+            let pending: PendingReply = Box::new(move |bytes: Option<Vec<u8>>| {
+                let _ = bytes;
+                let _ = sender.send(());
+            });
+            Some((
+                WireWebGLMsg::ClearPainterResources { painter_id, corr },
+                Some((corr, pending)),
+            ))
+        },
+        WebGLMsg::Exit => Some((WireWebGLMsg::Exit, None)),
+        WebGLMsg::WebXRCommand(_) => {
+            warn!("[webgl-bridge] WebXRCommand not supported on GPU broker; dropping");
+            None
+        },
+    }
+}
+
+#[allow(dead_code)]
+fn _touch_channel() {
+    let _ = webgl_channel::<()>();
+}
+
+#[allow(dead_code)]
+fn _touch_ok(ok: WireCreateContextOk) {
+    let _ = ok;
+}
