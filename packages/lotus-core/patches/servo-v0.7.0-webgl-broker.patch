+++ b/components/webgl/broker_frame.rs
@@ -0,0 +1,159 @@
+/* This Source Code Form is subject to the terms of the Mozilla Public
+ * License, v. 2.0. If a copy of the MPL was not distributed with this
+ * file, You can obtain one at https://mozilla.org/MPL/2.0/. */
+
+//! Framing helpers for `LOTUS_GPU_FD` — keep in sync with `lotus_supervisor::gpu_frame`.
+
+use std::os::unix::io::RawFd;
+
+pub const HEADER_BYTES: usize = 24;
+pub const KIND_PING: u32 = 1;
+pub const KIND_PONG: u32 = 2;
+pub const KIND_COMMAND: u32 = 3;
+pub const KIND_REPLY: u32 = 4;
+pub const KIND_CONTEXT_ABANDONED: u32 = 5;
+pub const KIND_CANVAS_PRESENT: u32 = 6;
+
+#[derive(Debug, Clone, Copy)]
+pub struct GpuFrameHeader {
+    pub body_len: u32,
+    pub corr: u64,
+    pub context_id: u64,
+    pub kind: u32,
+}
+
+impl GpuFrameHeader {
+    pub fn encode(self) -> [u8; HEADER_BYTES] {
+        let mut b = [0u8; HEADER_BYTES];
+        b[0..4].copy_from_slice(&self.body_len.to_le_bytes());
+        b[4..12].copy_from_slice(&self.corr.to_le_bytes());
+        b[12..20].copy_from_slice(&self.context_id.to_le_bytes());
+        b[20..24].copy_from_slice(&self.kind.to_le_bytes());
+        b
+    }
+
+    pub fn decode(bytes: &[u8; HEADER_BYTES]) -> Self {
+        Self {
+            body_len: u32::from_le_bytes(bytes[0..4].try_into().unwrap()),
+            corr: u64::from_le_bytes(bytes[4..12].try_into().unwrap()),
+            context_id: u64::from_le_bytes(bytes[12..20].try_into().unwrap()),
+            kind: u32::from_le_bytes(bytes[20..24].try_into().unwrap()),
+        }
+    }
+}
+
+pub fn read_exact_fd(fd: RawFd, buf: &mut [u8]) -> Result<(), &'static str> {
+    let mut off = 0;
+    while off < buf.len() {
+        let n = unsafe {
+            libc::read(
+                fd,
+                buf[off..].as_mut_ptr() as *mut libc::c_void,
+                buf.len() - off,
+            )
+        };
+        if n < 0 {
+            return Err("E_READ");
+        }
+        if n == 0 {
+            return Err("E_EOF");
+        }
+        off += n as usize;
+    }
+    Ok(())
+}
+
+pub fn write_exact_fd(fd: RawFd, buf: &[u8]) -> Result<(), &'static str> {
+    let mut off = 0;
+    while off < buf.len() {
+        let n = unsafe {
+            libc::write(
+                fd,
+                buf[off..].as_ptr() as *const libc::c_void,
+                buf.len() - off,
+            )
+        };
+        if n < 0 {
+            return Err("E_WRITE");
+        }
+        if n == 0 {
+            return Err("E_WRITE_ZERO");
+        }
+        off += n as usize;
+    }
+    Ok(())
+}
+
+pub fn write_frame(fd: RawFd, header: GpuFrameHeader, body: &[u8]) -> Result<(), &'static str> {
+    if u32::try_from(body.len()).ok() != Some(header.body_len) {
+        return Err("E_HEADER_BODY_MISMATCH");
+    }
+    write_exact_fd(fd, &header.encode())?;
+    if !body.is_empty() {
+        write_exact_fd(fd, body)?;
+    }
+    Ok(())
+}
+
+pub fn read_header(fd: RawFd) -> Result<GpuFrameHeader, &'static str> {
+    let mut raw = [0u8; HEADER_BYTES];
+    read_exact_fd(fd, &mut raw)?;
+    Ok(GpuFrameHeader::decode(&raw))
+}
+
+/// Read header (+ optional body) and at most one SCM_RIGHTS fd (`MSG_CMSG_CLOEXEC`).
+pub fn read_frame_with_optional_fd(
+    fd: RawFd,
+) -> Result<(GpuFrameHeader, Vec<u8>, Option<RawFd>), &'static str> {
+    let mut raw = [0u8; HEADER_BYTES];
+    let mut iov = libc::iovec {
+        iov_base: raw.as_mut_ptr() as *mut libc::c_void,
+        iov_len: HEADER_BYTES,
+    };
+    let cmsg_space = unsafe { libc::CMSG_SPACE(std::mem::size_of::<RawFd>() as u32) as usize };
+    let mut cmsg_buf = vec![0u8; cmsg_space];
+    let mut msg: libc::msghdr = unsafe { std::mem::zeroed() };
+    msg.msg_iov = &mut iov;
+    msg.msg_iovlen = 1;
+    msg.msg_control = cmsg_buf.as_mut_ptr() as *mut libc::c_void;
+    msg.msg_controllen = cmsg_space as _;
+
+    let n = unsafe { libc::recvmsg(fd, &mut msg, libc::MSG_CMSG_CLOEXEC) };
+    if n < 0 {
+        return Err("E_RECVMSG");
+    }
+    if n == 0 {
+        return Err("E_EOF");
+    }
+    if n as usize != HEADER_BYTES {
+        // SOCK_STREAM may deliver a short header; fall back to completing the header.
+        let got = n as usize;
+        read_exact_fd(fd, &mut raw[got..])?;
+    }
+
+    let mut passed_fd: Option<RawFd> = None;
+    unsafe {
+        let mut cmsg = libc::CMSG_FIRSTHDR(&msg);
+        while !cmsg.is_null() {
+            if (*cmsg).cmsg_level == libc::SOL_SOCKET && (*cmsg).cmsg_type == libc::SCM_RIGHTS {
+                let data_ptr = libc::CMSG_DATA(cmsg) as *const RawFd;
+                let data_len = (*cmsg).cmsg_len as usize - libc::CMSG_LEN(0) as usize;
+                let count = data_len / std::mem::size_of::<RawFd>();
+                if count >= 1 {
+                    passed_fd = Some(*data_ptr);
+                    for i in 1..count {
+                        libc::close(*data_ptr.add(i));
+                    }
+                }
+            }
+            cmsg = libc::CMSG_NXTHDR(&msg, cmsg);
+        }
+    }
+
+    let hdr = GpuFrameHeader::decode(&raw);
+    let mut body = vec![0u8; hdr.body_len as usize];
+    if !body.is_empty() {
+        read_exact_fd(fd, &mut body)?;
+    }
+    Ok((hdr, body, passed_fd))
+}
