+/// Premultiply straight BGRA8 in place (WebRender expects premultiplied BGRA for buffer external images).
+fn premultiply_bgra8_inplace(pixels: &mut [u8]) {
+    for chunk in pixels.chunks_exact_mut(4) {
+        let b = chunk[0] as u32;
+        let g = chunk[1] as u32;
+        let r = chunk[2] as u32;
+        let a = chunk[3] as u32;
+        if a == 255 || a == 0 {
+            continue;
+        }
+        chunk[0] = ((b * a + 127) / 255) as u8;
+        chunk[1] = ((g * a + 127) / 255) as u8;
+        chunk[2] = ((r * a + 127) / 255) as u8;
+    }
