+/// Open a TCP connection to `domain:port`, tunneling via HTTP CONNECT when
+/// `network_http_proxy_uri` is set (sandboxed engines reach the host IPC port
+/// only through the jail network broker; direct `127.0.0.1` is the netns loopback).
+async fn connect_ws_tcp(domain: &str, port: u16) -> Result<TcpStream, Error> {
+    let proxy_uri = pref!(network_http_proxy_uri);
+    if proxy_uri.is_empty() {
+        return TcpStream::connect((domain, port))
+            .await
+            .map_err(Error::Io);
+    }
+
+    let proxy: http::Uri = proxy_uri.parse().map_err(|e| {
+        Error::Url(UrlError::UnableToConnect(format!(
+            "invalid network_http_proxy_uri: {e}"
+        )))
+    })?;
+    let proxy_host = proxy.host().ok_or_else(|| {
+        Error::Url(UrlError::UnableToConnect(
+            "network_http_proxy_uri has no host".into(),
+        ))
+    })?;
+    let proxy_port = proxy.port_u16().unwrap_or(80);
+
+    let mut stream = TcpStream::connect((proxy_host, proxy_port))
+        .await
+        .map_err(Error::Io)?;
+
+    let authority = format!("{domain}:{port}");
+    let connect_req = format!(
+        "CONNECT {authority} HTTP/1.1\r\nHost: {authority}\r\nProxy-Connection: Keep-Alive\r\n\r\n"
+    );
+    stream
+        .write_all(connect_req.as_bytes())
+        .await
+        .map_err(Error::Io)?;
+
+    let mut buf = Vec::with_capacity(256);
+    loop {
+        let mut byte = [0u8; 1];
+        stream.read_exact(&mut byte).await.map_err(Error::Io)?;
+        buf.push(byte[0]);
+        if buf.len() >= 4 && buf[buf.len() - 4..] == *b"\r\n\r\n" {
+            break;
+        }
+        if buf.len() > 8192 {
+            return Err(Error::Url(UrlError::UnableToConnect(
+                "HTTP CONNECT proxy response too large".into(),
+            )));
+        }
+    }
+
+    let status_ok = buf.starts_with(b"HTTP/1.1 200") || buf.starts_with(b"HTTP/1.0 200");
+    if !status_ok {
+        let preview = String::from_utf8_lossy(&buf);
+        return Err(Error::Url(UrlError::UnableToConnect(format!(
+            "HTTP CONNECT to {authority} failed: {preview}"
+        ))));
+    }
+
+    Ok(stream)
+}
