+    /// Read the default framebuffer into BGRA8 premultiplied bytes (top row first) for WebRender Buffer images.
+    fn readback_present_default_framebuffer(
+        &self,
+        context_id: WebGLContextId,
+        size: Size2D<i32>,
+        has_alpha: bool,
+        premultiplied_alpha: bool,
+        gl: &Gl,
+        canvas_epoch: Option<Epoch>,
+    ) {
+        let w = size.width.max(0) as usize;
+        let h = size.height.max(0) as usize;
+        if w == 0 || h == 0 {
+            return;
+        }
+        let mut pixels = vec![0u8; w * h * 4];
+        let use_bgra = !gl.version().is_embedded;
+        unsafe {
+            gl.pixel_store_i32(gl::PACK_ALIGNMENT, 4);
+            gl.read_pixels(
+                0,
+                0,
+                size.width,
+                size.height,
+                if use_bgra {
+                    gl::BGRA
+                } else {
+                    gl::RGBA
+                },
+                gl::UNSIGNED_BYTE,
+                glow::PixelPackData::Slice(Some(&mut pixels)),
+            );
+        }
+        if !use_bgra {
+            // GLES readback is RGBA; WebRender BGRA8 expects B,G,R,A byte order.
+            for chunk in pixels.chunks_exact_mut(4) {
+                chunk.swap(0, 2);
+            }
+        }
+        // glReadPixels is bottom-up; WebRender Buffer external images expect top row first.
+        {
+            let stride = w * 4;
+            let mut tmp = vec![0u8; stride];
+            for y in 0..(h / 2) {
+                let top = y * stride;
+                let bot = (h - 1 - y) * stride;
+                tmp.copy_from_slice(&pixels[top..top + stride]);
+                pixels.copy_within(bot..bot + stride, top);
+                pixels[bot..bot + stride].copy_from_slice(&tmp);
+            }
+        }
+        if !premultiplied_alpha && has_alpha {
+            premultiply_bgra8_inplace(&mut pixels);
+        } else if !has_alpha {
+            for chunk in pixels.chunks_exact_mut(4) {
+                chunk[3] = 255;
+            }
+        }
+        if let Some(ref cb) = self.on_present {
+            cb(context_id, size, &pixels, canvas_epoch);
+        }
+        self.presented_buffer_map.write().insert(
+            context_id,
+            WebGLPresentedFrame {
+                size,
+                pixels: Arc::new(pixels),
+            },
+        );
+    }
