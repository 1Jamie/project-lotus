+/* This Source Code Form is subject to the terms of the Mozilla Public
+ * License, v. 2.0. If a copy of the MPL was not distributed with this
+ * file, You can obtain one at https://mozilla.org/MPL/2.0/. */
+
+//! Jail-side reader for the host WebGL canvas memfd plane.
+//! Layout must match `lotus_supervisor::canvas_plane`.
+
+use std::os::unix::io::{FromRawFd, OwnedFd, RawFd};
+use std::sync::atomic::{AtomicU64, Ordering};
+use std::sync::Arc;
+
+use euclid::default::Size2D;
+use log::warn;
+use parking_lot::RwLock;
+use rustc_hash::FxHashMap;
+use servo_canvas_traits::webgl::WebGLContextId;
+
+use crate::webgl_presented_frames::{WebGLPresentedBufferMap, WebGLPresentedFrame};
+
+pub const CANVAS_HEADER_BYTES: usize = 128;
+
+#[repr(C)]
+struct CanvasPlaneHeader {
+    active_slot: AtomicU64,
+    width: u32,
+    height: u32,
+    stride_bytes: u32,
+    _reserved: u32,
+    slot_seq: [AtomicU64; 2],
+    _pad: [u8; 128 - 8 - 16 - 16],
+}
+
+const _: () = assert!(std::mem::size_of::<CanvasPlaneHeader>() == CANVAS_HEADER_BYTES);
+
+pub struct CanvasPlaneReader {
+    _fd: OwnedFd,
+    ptr: *const u8,
+    size: usize,
+}
+
+// Safety: mapping is shared read-only memfd; we only do atomic seqlock reads + copy.
+unsafe impl Send for CanvasPlaneReader {}
+unsafe impl Sync for CanvasPlaneReader {}
+
+impl Drop for CanvasPlaneReader {
+    fn drop(&mut self) {
+        if !self.ptr.is_null() && self.size > 0 {
+            unsafe {
+                libc::munmap(self.ptr as *mut libc::c_void, self.size);
+            }
+        }
+    }
+}
+
+impl CanvasPlaneReader {
+    /// Map a read-only canvas memfd received from the host.
+    pub fn map_ro(fd: RawFd, size_hint: usize) -> Result<Self, &'static str> {
+        let mut stat: libc::stat = unsafe { std::mem::zeroed() };
+        if unsafe { libc::fstat(fd, &mut stat) } != 0 || stat.st_size <= 0 {
+            return Err("E_CANVAS_FSTAT");
+        }
+        let size = stat.st_size as usize;
+        if size < CANVAS_HEADER_BYTES || (size_hint > 0 && size < size_hint) {
+            return Err("E_CANVAS_TOO_SMALL");
+        }
+        let ptr = unsafe {
+            libc::mmap(
+                std::ptr::null_mut(),
+                size,
+                libc::PROT_READ,
+                libc::MAP_SHARED,
+                fd,
+                0,
+            ) as *const u8
+        };
+        if ptr == libc::MAP_FAILED as *const u8 {
+            return Err("E_CANVAS_MMAP");
+        }
+        Ok(Self {
+            _fd: unsafe { OwnedFd::from_raw_fd(fd) },
+            ptr,
+            size,
+        })
+    }
+
+    pub fn try_copy_frame(&self, out: &mut Vec<u8>) -> Option<(u32, u32)> {
+        unsafe { try_copy_frame(self.ptr, out) }
+    }
+}
+
+unsafe fn try_copy_frame(ptr: *const u8, out: &mut Vec<u8>) -> Option<(u32, u32)> {
+    let hdr = unsafe { &*(ptr as *const CanvasPlaneHeader) };
+    let w = hdr.width;
+    let h = hdr.height;
+    let stride = hdr.stride_bytes as usize;
+    if w == 0 || h == 0 {
+        return None;
+    }
+    let need = stride.saturating_mul(h as usize);
+    if CANVAS_HEADER_BYTES + need * 2 > usize::MAX / 2 {
+        return None;
+    }
+    for _ in 0..4 {
+        let slot = hdr.active_slot.load(Ordering::Acquire) as usize & 1;
+        let seq1 = hdr.slot_seq[slot].load(Ordering::Acquire);
+        if seq1 & 1 != 0 {
+            continue;
+        }
+        std::sync::atomic::fence(Ordering::Acquire);
+        out.resize(need, 0);
+        unsafe {
+            let base = ptr.add(CANVAS_HEADER_BYTES + slot * need);
+            std::ptr::copy_nonoverlapping(base, out.as_mut_ptr(), need);
+        }
+        std::sync::atomic::fence(Ordering::Acquire);
+        let seq2 = hdr.slot_seq[slot].load(Ordering::Acquire);
+        if seq1 == seq2 && seq2 & 1 == 0 {
+            return Some((w, h));
+        }
+    }
+    None
+}
+
+pub type CanvasPlaneMap = Arc<RwLock<FxHashMap<WebGLContextId, Arc<CanvasPlaneReader>>>>;
+
+pub fn sync_presented_from_plane(
+    planes: &CanvasPlaneMap,
+    presented: &WebGLPresentedBufferMap,
+    context_id: WebGLContextId,
+) -> Option<Size2D<i32>> {
+    let reader = {
+        let map = planes.read();
+        match map.get(&context_id) {
+            Some(r) => Arc::clone(r),
+            None => return None,
+        }
+    };
+    let mut buf = Vec::new();
+    let (w, h) = reader.try_copy_frame(&mut buf)?;
+    let size = Size2D::new(w as i32, h as i32);
+    presented.write().insert(
+        context_id,
+        WebGLPresentedFrame {
+            size,
+            pixels: Arc::new(buf),
+        },
+    );
+    Some(size)
+}
+
+pub fn forget_plane(planes: &CanvasPlaneMap, context_id: WebGLContextId) {
+    planes.write().remove(&context_id);
+}
+
+pub fn insert_plane(planes: &CanvasPlaneMap, context_id: WebGLContextId, reader: CanvasPlaneReader) {
+    planes.write().insert(context_id, Arc::new(reader));
+}
+
+pub fn map_ro_logged(fd: RawFd) -> Option<CanvasPlaneReader> {
+    match CanvasPlaneReader::map_ro(fd, 0) {
+        Ok(r) => Some(r),
+        Err(e) => {
+            warn!("[webgl-bridge] canvas map failed ({e}); closing fd");
+            unsafe {
+                libc::close(fd);
+            }
+            None
+        },
+    }
+}
