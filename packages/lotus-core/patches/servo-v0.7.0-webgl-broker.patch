new file mode 100644
index 00000000000..f955f1c7f90
--- /dev/null
+++ b/components/webgl/webgl_presented_frames.rs
@@ -0,0 +1,94 @@
+/* This Source Code Form is subject to the terms of the Mozilla Public
+ * License, v. 2.0. If a copy of the MPL was not distributed with this
+ * file, You can obtain one at https://mozilla.org/MPL/2.0/. */
+
+//! Latest WebGL canvas readback per context (BGRA8 premultiplied, top row first) for Buffer external images.
+
+use euclid::default::Size2D;
+use parking_lot::RwLock;
+use rustc_hash::FxHashMap;
+use servo_canvas_traits::webgl::WebGLContextId;
+use std::sync::Arc;
+
+/// One frame of pixels presented to WebRender as `ExternalImageType::Buffer`.
+#[derive(Clone, Debug)]
+pub struct WebGLPresentedFrame {
+    pub size: Size2D<i32>,
+    pub pixels: Arc<Vec<u8>>,
+}
+
+pub type WebGLPresentedBufferMap = Arc<RwLock<FxHashMap<WebGLContextId, WebGLPresentedFrame>>>;
+
+/// Tracks both the latest WebRender `ImageDescriptor` dimensions and the high-water byte
+/// floor across in-flight `WRRenderBackend` transactions so a rapid shrink never returns
+/// a slice smaller than an earlier queued `TextureCacheUpdate`'s `src_size`.
+#[derive(Clone, Copy, Debug)]
+pub struct WebGLDescriptorState {
+    pub current_size: Size2D<i32>,
+    pub max_bytes: usize,
+    pub grace_locks: u8,
+}
+
+impl WebGLDescriptorState {
+    pub fn record_size(prev: Option<Self>, size: Size2D<i32>) -> Self {
+        let current_size = Size2D::new(size.width.max(1), size.height.max(1));
+        let new_bytes = (current_size.width as usize)
+            .saturating_mul(current_size.height as usize)
+            .saturating_mul(4);
+        match prev {
+            Some(old) if new_bytes < old.max_bytes => Self {
+                current_size,
+                max_bytes: old.max_bytes,
+                grace_locks: 16,
+            },
+            Some(old) => Self {
+                current_size,
+                max_bytes: old.max_bytes.max(new_bytes),
+                grace_locks: old.grace_locks,
+            },
+            None => Self {
+                current_size,
+                max_bytes: new_bytes,
+                grace_locks: 0,
+            },
+        }
+    }
+}
+
+pub type WebGLDescriptorSizeMap = Arc<RwLock<FxHashMap<WebGLContextId, WebGLDescriptorState>>>;
+
+/// Fast 32-bit BGRA8 nearest-neighbor resample for transition frames when
+/// WebRender's committed ImageDescriptor size differs from the latest presented frame.
+/// `min_alloc_bytes` ensures the returned `Vec<u8>` is at least as large as any
+/// in-flight larger `TextureCacheUpdate` in `WRRenderBackend`.
+pub fn stretch_bgra8_nearest(
+    src: &[u8],
+    src_size: Size2D<i32>,
+    dst_size: Size2D<i32>,
+    min_alloc_bytes: usize,
+) -> Vec<u8> {
+    let sw = src_size.width.max(1) as usize;
+    let sh = src_size.height.max(1) as usize;
+    let dw = dst_size.width.max(1) as usize;
+    let dh = dst_size.height.max(1) as usize;
+    let dst_bytes = dw.saturating_mul(dh).saturating_mul(4);
+    let alloc_bytes = dst_bytes.max(min_alloc_bytes);
+    let mut dst = vec![0u8; alloc_bytes];
+    let needed = sw.saturating_mul(sh).saturating_mul(4);
+    if src.len() < needed || dst_bytes == 0 {
+        return dst;
+    }
+    let src_valid = &src[..needed];
+    let src_stride = sw * 4;
+    let dst_stride = dw * 4;
+    for (dy, dst_row) in dst[..dst_bytes].chunks_exact_mut(dst_stride).enumerate() {
+        let sy = (dy * sh) / dh;
+        let src_row = &src_valid[sy * src_stride..(sy + 1) * src_stride];
+        for (dx, dst_px) in dst_row.chunks_exact_mut(4).enumerate() {
+            let sx = (dx * sw) / dw;
+            let src_off = sx * 4;
+            dst_px.copy_from_slice(&src_row[src_off..src_off + 4]);
+        }
+    }
+    dst
+}
