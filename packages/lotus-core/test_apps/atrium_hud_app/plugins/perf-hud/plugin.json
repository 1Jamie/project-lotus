{
  "id": "perf-hud",
  "name": "Perf HUD",
  "version": "0.1.0",
  "host": "host.js",
  "panes": {
    "main": {
      "type": "surface",
      "entry": "ui/index.html",
      "defaultRect": { "x": 16, "y": 64, "width": 280, "height": 220 },
      "layer": "hud",
      "visibility": "always",
      "interactive": "overlay-only"
    }
  },
  "shellButtons": [
    {
      "id": "toggle",
      "label": "HUD",
      "shortcut": "F10",
      "action": "toggle-pane:main"
    }
  ]
}
