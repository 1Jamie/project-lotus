{
  "name": "@lotus-gui/core",
  "version": "0.4.0",

  "main": "lotus.js",
  "types": "lotus.d.ts",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/1Jamie/project-lotus.git"
  },
  "keywords": [
    "gui",
    "framework",
    "desktop",
    "electron-alternative",
    "rust",
    "servo",
    "html",
    "css",
    "js",
    "napi-rs",
    "runtime",
    "engine"
  ],
  "files": [
    "README.md",
    "lotus.js",
    "lotus.d.ts",
    "index.js",
    "index.d.ts",
    "package.json",
    "*.node",
    "resources/",
    "scripts/",
    "windows/"
  ],
  "napi": {
    "name": "lotus",
    "triples": {
      "defaults": true,
      "additional": [
        "x86_64-unknown-linux-gnu",
        "x86_64-pc-windows-msvc"
      ]
    }
  },
  "scripts": {
    "build": "napi build --platform --release",
    "prebuild": "node scripts/apply-patches.js",
    "build:debug": "napi build --platform",
    "extract-angle": "node scripts/extract_angle_dlls.js",
    "patch": "bash ./scripts/apply-patches.sh",
    "clean": "node scripts/clean.js",
    "artifacts": "echo 'Artifacts moved by CI workflow'",
    "postinstall": "node scripts/install.js",
    "test": "npm run test-app",
    "test-app": "RUST_LOG=info LOTUS_DEV_REQ=../ node test_app/main.js",
    "multipane-test-app": "RUST_LOG=info LOTUS_DEV_REQ=../ node multi_pane_test_app/main.js",
    "test-app:multi": "npm run multipane-test-app",
    "start": "npm run test-app",
    "start:multi": "npm run multipane-test-app",
    "benchmark": "RUST_LOG=info LOTUS_DEV_REQ=../ node ipc-benchmark/main.js"
  },
  "devDependencies": {
    "@napi-rs/cli": "^2.16.0"
  },
  "dependencies": {
    "msgpackr": "^1.11.8"
  }
}